:80 {
    # Baseline response headers for everything this site serves — frontend and API
    # alike (R4-T5-08). No HSTS: this stack is plain http on localhost.
    # The leading ? sets the header only when the response does not already carry
    # one, so the cached-page reader CSP (sandbox; ...) is never overwritten.
    header {
        X-Content-Type-Options nosniff
        ?Content-Security-Policy "frame-ancestors 'self'"
        Referrer-Policy strict-origin-when-cross-origin
    }

    # API routes to backend (8 min timeout for long-running scrape tests)
    handle /api/* {
        reverse_proxy backend:8000 {
            transport http {
                read_timeout 480s
            }
        }
    }

    # Health check
    handle /health {
        reverse_proxy backend:8000
    }

    # Telegram webhook
    handle /api/telegram/webhook {
        reverse_proxy backend:8000
    }

    # Swagger UI, ReDoc, OpenAPI schema
    handle /docs {
        reverse_proxy backend:8000
    }
    handle /docs/* {
        reverse_proxy backend:8000
    }
    handle /redoc {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }

    # Tracer link redirects — path style (/cv/{token})
    handle /cv/* {
        reverse_proxy backend:8000
    }

    # Tracer link redirects — param style (/?cv={token}); bare / still goes to frontend
    @tracer_param query cv=*
    handle @tracer_param {
        reverse_proxy backend:8000
    }

    # Everything else to frontend
    handle {
        reverse_proxy frontend:80
    }
}
